                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource InspectorLabelStyle}" Text="Icono" />
                                        <GridView Height="164" SelectionMode="Single" ItemsSource="{x:Bind ViewModel.IconOptions}" SelectedItem="{x:Bind ViewModel.SelectedIconOption, Mode=TwoWay}">
