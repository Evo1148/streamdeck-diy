                                <TextBlock Grid.Row="4" Style="{StaticResource SecondaryTextStyle}" Text="Encoder" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.EncodersText, Mode=OneWay}" />
                                <TextBlock Grid.Row="5" Style="{StaticResource SecondaryTextStyle}" Text="Capacidades" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.CapabilitiesText, Mode=OneWay}" />
                                <TextBlock Grid.Row="6" Style="{StaticResource SecondaryTextStyle}" Text="Hardware stats" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.Dashboard.HardwareStatsStatusText, Mode=OneWay}" />
                                <TextBlock Grid.Row="7" Style="{StaticResource SecondaryTextStyle}" Text="Sensor CPU" /><TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Bind ViewModel.Dashboard.CpuSensorStatusText, Mode=OneWay}" />
                                <TextBlock Grid.Row="8" Style="{StaticResource SecondaryTextStyle}" Text="Sensor GPU" /><TextBlock Grid.Row="8" Grid.Column="1" Text="{x:Bind ViewModel.Dashboard.GpuSensorStatusText, Mode=OneWay}" />
                                <TextBlock Grid.Row="9" Style="{StaticResource SecondaryTextStyle}" Text="Temperaturas" /><TextBlock Grid.Row="9" Grid.Column="1" Text="{x:Bind ViewModel.Dashboard.TemperatureSensorStatusText, Mode=OneWay}" />
                                <TextBlock Grid.Row="10" Style="{StaticResource SecondaryTextStyle}" Text="Diagnóstico" /><TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Dashboard.HardwareStatsDiagnosticText, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="11" Margin="0,8,0,0" FontWeight="SemiBold" Text="DisplayLink" /><TextBlock Grid.Row="11" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource SecondaryTextStyle}" Text="Protocolo de pantalla" />
