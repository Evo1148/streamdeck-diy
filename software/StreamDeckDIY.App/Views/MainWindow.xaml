                            <StackPanel Spacing="8"><Border Width="84" Height="84" HorizontalAlignment="Left" CornerRadius="12" Background="{StaticResource BrandAccentSubtleBrush}"><FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="34" Foreground="{StaticResource BrandAccentBrush}" Glyph="&#xE772;" /></Border><TextBlock FontSize="22" FontWeight="SemiBold" Text="StreamDeck DIY" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Información comunicada por el dispositivo conectado." TextWrapping="Wrap" /><Border Margin="0,16,0,0" Padding="12" Style="{StaticResource ModulePanelStyle}"><StackPanel Spacing="8"><TextBlock FontWeight="SemiBold" Text="Actualización de firmware" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Reinicia el dispositivo como unidad RPI-RP2." TextWrapping="Wrap" /><Button HorizontalAlignment="Left" Content="Entrar en modo actualización" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}" Command="{x:Bind ViewModel.FirmwareUpdate.EnterBootloaderCommand}" /><TextBlock Style="{StaticResource StatusTextStyle}" Text="{x:Bind ViewModel.FirmwareUpdate.StatusText, Mode=OneWay}" TextWrapping="Wrap" /></StackPanel></Border></StackPanel>
