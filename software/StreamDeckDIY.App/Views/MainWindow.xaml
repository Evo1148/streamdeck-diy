                                <TextBlock Grid.Row="17" Style="{StaticResource SecondaryTextStyle}" Text="Host" /><TextBlock Grid.Row="17" Grid.Column="1" Text="{x:Bind ViewModel.DisplayLinkHostText, Mode=OneWay}" />
