<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#151515</Color>
    <Color x:Key="PanelColor">#1B1B1B</Color>
    <Color x:Key="ElevatedColor">#222222</Color>
    <Color x:Key="SubtleBorderColor">#303030</Color>
    <Color x:Key="PrimaryTextColor">#F2F2F2</Color>
    <Color x:Key="SecondaryTextColor">#A0A0A0</Color>
    <Color x:Key="DisabledTextColor">#666666</Color>
    <Color x:Key="AccentColor">#7C3AED</Color>
    <Color x:Key="AccentHoverColor">#8B5CF6</Color>
    <Color x:Key="AccentPressedColor">#6D28D9</Color>
    <Color x:Key="AccentSubtleColor">#267C3AED</Color>
    <Color x:Key="SuccessColor">#4CAF78</Color>
    <Color x:Key="ErrorColor">#E66B6B</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="{StaticResource SubtleBorderColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="BrandAccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="BrandAccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="BrandAccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

    <!-- Keep product selection independent from the user's Windows accent color. -->
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource AccentSubtleColor}" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#347C3AED" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#407C3AED" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{StaticResource AccentSubtleColor}" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#347C3AED" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#407C3AED" />
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="{StaticResource AccentHoverColor}" />

    <x:Double x:Key="Space4">4</x:Double>
    <x:Double x:Key="Space8">8</x:Double>
    <x:Double x:Key="Space12">12</x:Double>
    <x:Double x:Key="Space16">16</x:Double>
    <x:Double x:Key="Space24">24</x:Double>
    <x:Double x:Key="Space32">32</x:Double>
    <CornerRadius x:Key="RadiusInput">5</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">8</CornerRadius>
</ResourceDictionary>
